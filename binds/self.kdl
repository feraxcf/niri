binds {
    Pause { toggle-overview; }
    
    Mod+Left  { focus-column-or-monitor-left; }
    Mod+Right  { focus-column-or-monitor-right; }
    
    // Mod+Braceright  { swap-monitor-left; }
    
    Mod+Down      { focus-workspace-down; } // { focus-column-right; }
    Mod+Up        { focus-workspace-up; } // { focus-column-left; }
    Mod+Ctrl+Down { move-column-to-workspace-down; } // { move-column-right; }
    Mod+Ctrl+Up   { move-column-to-workspace-up; } // { move-column-left; }
    
    // Monitors
    Mod+Alt+Left  { focus-monitor-left; }
    Mod+Alt+Down  { focus-monitor-down; }
    Mod+Alt+Up    { focus-monitor-up; }
    Mod+Alt+Right { focus-monitor-right; }
    
    Mod+Alt+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Alt+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Alt+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Alt+Ctrl+Right { move-column-to-monitor-right; }
    
    Mod+Z hotkey-overlay-title="zed" { spawn "zed"; }
    Mod+B hotkey-overlay-title="zen" { spawn-sh " ~/.config/niri/scripts/open-program.sh zen-browser || flatpak run app.zen_browser.zen"; }
    Mod+N hotkey-overlay-title="nautilus" { spawn-sh "xdg-open ~"; }
    Mod+C hotkey-overlay-title="telegram" { spawn-sh "~/.config/niri/scripts/open-program.sh materialgram || flatpak run org.telegram.desktop"; }
    Mod+M hotkey-overlay-title="music" { spawn-sh "~/.config/niri/scripts/open-program.sh youtube-music"; }
    
    Shift+XF86AudioRaiseVolume { spawn-sh "~/.config/niri/scripts/volume.sh +"; }
    Shift+XF86AudioLowerVolume { spawn-sh "~/.config/niri/scripts/volume.sh -"; }
    
    XF86Cut { screenshot; }
    XF86Favorites hotkey-overlay-title="toggle" { spawn "~/.config/niri/scripts/toggle_screen.sh"; }
    
    Mod+K { spawn-sh "kill -9 $(niri msg focused-window | grep PID | cut -d' ' -f4)"; }
    
    Mod+Alt+K allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    Mod+Alt+L allow-when-locked=true { spawn-sh "playerctl position 10+"; }
    Mod+Alt+J allow-when-locked=true { spawn-sh "playerctl position 10-"; }
    Mod+Alt+M allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    // XF86AudioStop        allow-when-locked=true { spawn-sh "playerctl stop"; 
    Mod+Alt+N allow-when-locked=true { spawn-sh "playerctl previous"; }
    Mod+Alt+P allow-when-locked=true { spawn-sh "playerctl next"; }
    
    Mod+Print allow-when-locked=true { spawn-sh "pixelkit color-picker"; }
    Mod+XF86Cut allow-when-locked=true { spawn-sh "pixelkit color-picker"; }
    // Shift+Print allow-when-locked=true { spawn-sh "pixelkit screen-ruler"; }
    
    Mod+Scroll_Lock { spawn-sh "windowinfo=$(niri msg pick-window); ret_val=$(notify-send -t 1500 --action='copytext=Copy to clipboard' 'Picked Window Information:' \"$(echo \"$windowinfo\" | grep 'App ID' | cut -d: -f2 | cut -d'\"' -f2)\"); case $ret_val in 'copytext') wl-copy \"$windowinfo\" ;; esac"; }
    // Mod+Shift+F { toggle-windowed-fullscreen; }
}
